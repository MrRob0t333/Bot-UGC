# ---------------------------------------------------------------
# sales-bot — copie para .env e preencha. NUNCA commite o .env.
# ---------------------------------------------------------------

# Aplicação Discord PRÓPRIA deste bot (não reutilize o token do velvet-bot).
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Canais (podem ser o mesmo). ALERT_CHANNEL_ID vazio = alertas por DM aos donos.
SALES_CHANNEL_ID=
SUMMARY_CHANNEL_ID=
ALERT_CHANNEL_ID=

# Únicos usuários Discord que podem usar o bot (separados por vírgula).
OWNER_IDS=1108166595374751828,433699177705504768

# Cookie .ROBLOSECURITY da conta alternativa dedicada (só o valor, sem ".ROBLOSECURITY=").
ROBLOX_COOKIE=

# Coleta
POLL_INTERVAL_MINUTES=3
PENDING_RECHECK_DAYS=10
TIMEZONE=America/Sao_Paulo

# ---- Opcionais (valores padrão entre parênteses) ----
# Limite de requisições à Roblox por minuto (60)
# ROBLOX_REQUESTS_PER_MINUTE=60
# Timeout por requisição em ms (15000)
# ROBLOX_TIMEOUT_MS=15000
# Pausa entre páginas do backfill em ms (2000)
# BACKFILL_PAGE_DELAY_MS=2000
# Snapshot do saldo a cada N minutos (30)
# FUNDS_SNAPSHOT_MINUTES=30
# Quantos backups diários manter (14)
# BACKUP_KEEP=14
# Resumos automáticos (horário de TIMEZONE). Deixe vazio para desligar um deles.
# DAILY_SUMMARY_TIME=23:00
# WEEKLY_SUMMARY_DAY=0          (0 = domingo ... 6 = sábado)
# WEEKLY_SUMMARY_TIME=23:05
# MONTHLY_SUMMARY_DAY=1
# MONTHLY_SUMMARY_TIME=09:00
# Nível de log: debug | info | warn | error (info)
# LOG_LEVEL=info
