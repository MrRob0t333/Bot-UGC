# Create a separate Discord application and bot for this service.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Roblox Open Cloud API key with group read access for every monitored group.
ROBLOX_OPEN_CLOUD_API_KEY=

# Optional comma-separated Discord user IDs that can add or remove monitored groups.
# Discord server administrators can also manage the monitoring list.
ADMIN_USER_IDS=

# Restrict bot commands to one Discord channel. Leave empty to allow any channel.
COMMAND_CHANNEL_ID=1545914179167191040
