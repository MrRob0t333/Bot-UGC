# Create a separate Discord application and bot for this service.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Roblox Open Cloud API key with group read access for every monitored group.
ROBLOX_OPEN_CLOUD_API_KEY=

# Optional comma-separated Discord user IDs. These users can manage monitored groups.
# Discord server administrators can also manage them.
ADMIN_USER_IDS=
